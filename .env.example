# Copy to .env and export these before running image edit or video render.
# The generate modules read the process environment. They do not load this file.
COMFY_BASE_URL=https://your-image-deployment.run.comfy.app
COMFY_API_KEY=your-image-deployment-key
COMFY_VIDEO_BASE_URL=https://your-video-deployment.run.comfy.app
COMFY_VIDEO_API_KEY=your-video-deployment-key
